# Optional. Telegram username (without @) that order messages are sent to.
# Without it, "Send on Telegram" opens Telegram's share sheet instead.
VITE_TELEGRAM_USERNAME=

# Optional. POST endpoint that receives confirmed orders as JSON
# ({ order, message, totalUsd }). Without it, orders stay on the customer's
# device and are shared by Telegram, copy or print.
VITE_ORDER_ENDPOINT=
